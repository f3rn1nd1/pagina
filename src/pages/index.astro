---
const projects = [
  { id: '01', title: 'One · Nortrans', type: 'PLATAFORMA INTERNA', description: 'Un punto de acceso centralizado a sistemas, dashboards, ERP, Softland y tickets. Información y herramientas conectadas para el trabajo diario.', tags: ['Laravel', 'PHP', 'MySQL'], visual: 'portal' },
  { id: '02', title: 'Optimus', type: 'GESTIÓN DE PERSONAS', description: 'Sistema para apoyar la gestión de personal, contratos, documentación, servicios y centros de costos, con roles y permisos de acceso.', tags: ['Laravel', 'Spatie', 'Tailwind CSS'], visual: 'people' },
  { id: '03', title: 'Datos que orientan', type: 'BUSINESS INTELLIGENCE', description: 'Dashboards para mantención, recursos humanos, finanzas y control operacional. Métricas con DAX y conexión de datos desde hojas de cálculo.', tags: ['Power BI', 'DAX', 'Análisis de datos'], visual: 'data' },
];
const skills = [
 { title: 'Desarrollo web', items: 'Laravel · PHP · JavaScript · React · MySQL · Tailwind CSS · Flowbite' },
 { title: 'Datos e inteligencia de negocios', items: 'Power BI · DAX · SQL · Looker Studio · Hojas de cálculo' },
 { title: 'Plataformas y operación', items: 'Moodle · CPanel · SMTP · Cron jobs · Roles y permisos' },
 { title: 'Personas y procesos', items: 'Capacitación · Soporte a usuarios · Documentación · Google Workspace · Microsoft Office' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Portafolio de Yomara Bernal: desarrollo web, análisis de datos e inteligencia de negocios. Conoce su experiencia y proyectos." />
    <meta name="theme-color" content="#f5f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Yomara Bernal — Desarrollo web & datos</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <header class="container header">
      <a class="brand" href="#inicio" aria-label="Yomara Bernal, inicio">yb<span>.</span></a>
      <nav aria-label="Navegación principal"><a href="#proyectos">Proyectos</a><a href="#sobre-mi">Sobre mí</a><a href="#contacto" class="nav-contact">Hablemos <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="contenido">
      <section id="inicio" class="container hero">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot"></span> DESARROLLO WEB & ANÁLISIS DE DATOS</p>
          <h1>Conecto ideas,<br />tecnología <span class="serif">y datos.</span></h1>
          <p class="intro">Soy <strong>Yomara Bernal.</strong> Desarrollo soluciones digitales que ayudan a organizar procesos y convertir información en decisiones.</p>
          <div class="actions"><a class="button" href="#proyectos">Explorar mi trabajo <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:mbyomara301101@gmail.com">Contactar <span aria-hidden="true">↗</span></a></div>
          <p class="location">ALTO HOSPICIO, CHILE <span> / </span> TECNOLOGÍA CON PROPÓSITO</p>
        </div>
        <div class="hero-art" aria-hidden="true"><div class="art-grid"></div><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="core">yb<span>✳</span></div><div class="floating note-one">&lt;/&gt; <span>Desarrollo web</span></div><div class="floating note-two"><span class="mini-bars"><i></i><i></i><i></i></span> Datos + decisiones</div><span class="art-caption">DE LA IDEA A LA SOLUCIÓN</span></div>
      </section>
      <div class="ticker"><div class="container">DESARROLLO WEB <span>✳</span> BUSINESS INTELLIGENCE <span>✳</span> MEJORA DE PROCESOS <span>✳</span> SOLUCIONES DIGITALES</div></div>
      <section id="proyectos" class="container section">
        <div class="section-heading"><div><p class="eyebrow">01 / TRABAJO SELECCIONADO</p><h2>Soluciones con <span class="serif">impacto.</span></h2></div><p>Proyectos en los que participé<br />durante mi práctica en Nortrans.</p></div>
        <div class="projects">{projects.map(project => <article class="project"><div class:list={['project-visual', project.visual]} aria-hidden="true">{project.visual === 'portal' ? <div class="mock-window"><div class="mock-top"><b>one.</b><span>Workspace</span></div><div class="mock-welcome">Todo en un solo lugar.</div><div class="app-grid"><span>Sistemas ↗</span><span>Dashboards ↗</span><span>ERP ↗</span><span>Tickets ↗</span></div></div> : project.visual === 'people' ? <div class="mock-window"><div class="mock-top"><b>optimus</b><span>Gestión</span></div><div class="mock-welcome">Personas. Procesos. Conexión.</div><div class="mock-row"><i>↗</i><span>Personal y contratos</span><b>●</b></div><div class="mock-row"><i>≡</i><span>Documentación</span><b>●</b></div><div class="mock-row"><i>✳</i><span>Centros de costos</span><b>●</b></div></div> : <div class="mock-window"><div class="mock-top"><b>Overview</b><span>Power BI</span></div><div class="chart"><i style="--height:35%"></i><i style="--height:58%"></i><i style="--height:45%"></i><i style="--height:76%"></i><i style="--height:63%"></i><i style="--height:91%"></i></div><div class="chart-caption">Información que se vuelve perspectiva.</div></div>}<span class="visual-number">{project.id}</span></div><div class="project-body"><p class="eyebrow">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p><div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div></div></article>)}</div>
        <p class="project-note">Representaciones visuales conceptuales de los proyectos descritos en mi experiencia profesional.</p>
      </section>
      <section id="sobre-mi" class="about"><div class="container about-grid"><div><p class="eyebrow">02 / SOBRE MÍ</p><h2>Curiosidad para aprender.<br /><span class="serif">Criterio para resolver.</span></h2><p class="about-text">Mi formación en Ingeniería Civil en Computación e Informática en la Universidad Arturo Prat se complementa con experiencia práctica en desarrollo, inteligencia de negocios y apoyo a usuarios.</p><p class="about-text">Me interesa aportar en tecnologías de la información, análisis de procesos y transformación digital, creando herramientas útiles para las personas que las usan.</p><div class="education"><span>FORMACIÓN</span><strong>Universidad Arturo Prat</strong><p>Ingeniería Civil en Computación e Informática<br />2020–2025 · Formación indicada en el CV</p></div></div><div class="experience"><p class="eyebrow">MI RECORRIDO</p><article><span class="step">02</span><div><h3>Práctica Profesional II</h3><p class="company">Nortrans · Desarrollo de software / TI</p><p>Desarrollo de sistemas internos, dashboards y plataformas. Administración de hosting, automatización y capacitación a usuarios.</p></div></article><article><span class="step">01</span><div><h3>Práctica Profesional I</h3><p class="company">Desarrollo frontend · Flutter</p><p>Construcción y mejora de interfaces para un sistema administrativo, organización visual y lógica de navegación.</p></div></article></div></div></section>
      <section class="container section skills"><div class="section-heading"><div><p class="eyebrow">03 / HERRAMIENTAS & HABILIDADES</p><h2>Mi caja de <span class="serif">herramientas.</span></h2></div></div><div class="skills-grid">{skills.map((skill, index) => <article><span class="skill-number">0{index + 1}</span><h3>{skill.title}</h3><p>{skill.items}</p></article>)}</div></section>
      <section id="contacto" class="container contact"><p class="eyebrow">04 / SIGUIENTE PASO</p><h2>¿Creamos algo<br /><span class="serif">que haga la diferencia?</span></h2><p>Conversemos sobre desarrollo web, datos y oportunidades para aportar.</p><a class="button" href="mailto:mbyomara301101@gmail.com">Escríbeme <span aria-hidden="true">↗</span></a><a class="email" href="mailto:mbyomara301101@gmail.com">mbyomara301101@gmail.com</a></section>
    </main>
    <footer class="container"><a class="brand" href="#inicio">yb<span>.</span></a><p>© {new Date().getFullYear()} Yomara Bernal</p><a href="#inicio">Volver arriba ↑</a></footer>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth;scroll-padding-top:28px} :global(body){margin:0;background:#f5f4ee;color:#25281f;font-family:Arial,Helvetica,sans-serif;-webkit-font-smoothing:antialiased} :global(a){color:inherit;text-decoration:none} :global(a:focus-visible){outline:3px solid #66852c;outline-offset:6px} :global(::selection){background:#d8ed9c} .container{max-width:1200px;width:calc(100% - 96px);margin:auto}.header{display:flex;justify-content:space-between;align-items:center;height:108px;border-bottom:1px solid #dcded3}.brand{font-size:38px;font-weight:800;letter-spacing:-3px}.brand span{color:#789340}nav{display:flex;gap:34px;align-items:center;font-size:14px}.nav-contact{border:1px solid #bfc3b5;padding:12px 19px;border-radius:30px}.nav-contact span{margin-left:15px}.hero{display:grid;grid-template-columns:1.25fr 1fr;gap:40px;padding-top:86px;padding-bottom:82px;align-items:center}.eyebrow{font-size:11px;letter-spacing:1.7px;font-weight:700;line-height:1.6}.dot{display:inline-block;width:7px;height:7px;background:#7c9545;border-radius:50%;margin-right:9px}h1{font-size:clamp(44px,5.2vw,72px);line-height:1.06;letter-spacing:-3.7px;font-weight:500;margin:28px 0}.serif{font-family:Georgia,'Times New Roman',serif;font-style:italic;font-weight:400}.intro{font-size:17px;line-height:1.85;color:#606457;max-width:450px}.intro strong{color:#25281f}.actions{display:flex;gap:28px;align-items:center;margin-top:30px}.button{display:inline-flex;align-items:center;gap:36px;background:#25281f;color:#f5f4ee;border-radius:32px;padding:17px 25px;font-size:14px;transition:background .2s,transform .2s}.button:hover{background:#465635;transform:translateY(-2px)}.text-link{font-size:14px}.location{font-size:9px;letter-spacing:1.1px;margin-top:47px;color:#777e6c}.location span{margin:0 10px}.hero-art{height:420px;position:relative;background:#e7ebda;border-radius:150px 150px 16px 16px;overflow:hidden;display:grid;place-items:center}.art-grid{position:absolute;inset:0;background-image:linear-gradient(#8e9b7620 1px,transparent 1px),linear-gradient(90deg,#8e9b7620 1px,transparent 1px);background-size:32px 32px}.orbit{position:absolute;width:300px;height:300px;border:1px solid #8e9b7660;border-radius:50%}.orbit-two{width:220px;height:220px}.core{width:150px;height:150px;border-radius:40px;background:#d8ed9c;box-shadow:14px 18px 0 #abbf8160;display:flex;align-items:center;justify-content:center;font-size:80px;font-weight:700;letter-spacing:-8px;transform:rotate(-9deg)}.core span{position:absolute;right:-22px;top:-28px;font-size:74px;color:#475b2c;letter-spacing:0}.floating{position:absolute;background:#fbfcf4;border:1px solid #d5dcc8;border-radius:13px;padding:17px 20px;box-shadow:0 10px 25px #3440230a;font-size:13px}.note-one{top:80px;left:23px;transform:rotate(-6deg);font-size:22px}.note-one span{font-size:12px;margin-left:8px}.note-two{right:15px;bottom:87px;transform:rotate(5deg);display:flex;gap:13px;align-items:center}.mini-bars{display:flex;gap:3px;align-items:flex-end;height:21px}.mini-bars i{width:5px;height:12px;background:#789340}.mini-bars i:nth-child(2){height:21px}.mini-bars i:nth-child(3){height:17px}.art-caption{position:absolute;bottom:25px;font-size:9px;letter-spacing:2px;color:#65754a}.ticker{background:#25281f;color:#dde9c6;padding:22px 0}.ticker .container{display:flex;justify-content:space-between;gap:15px;font-size:10px;letter-spacing:1.5px;align-items:center}.ticker span{font-size:20px;color:#c8e593}.section{padding-top:90px;padding-bottom:85px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:38px}h2{font-size:clamp(32px,3.6vw,46px);line-height:1.15;letter-spacing:-1.8px;font-weight:500;margin:15px 0 0}.section-heading>p{font-size:13px;line-height:1.8;color:#737767}.projects{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.project-visual{height:252px;border-radius:13px;position:relative;display:flex;align-items:center;justify-content:center;padding:25px;overflow:hidden}.portal{background:#e4e9d8}.people{background:#eae3d9}.data{background:#dfe5e7}.mock-window{width:100%;background:#fafbf6;border-radius:9px;padding:18px;box-shadow:0 14px 25px #333b2210;transform:rotate(-3deg)}.people .mock-window{transform:rotate(3deg)}.mock-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e2e5da;padding-bottom:12px;font-size:10px}.mock-top b{font-size:15px}.mock-top span{color:#7c806f}.mock-welcome{font-size:12px;margin:17px 0}.app-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.app-grid span{padding:13px 8px;background:#e9efdb;border-radius:5px;font-size:9px}.mock-row{display:flex;align-items:center;gap:9px;font-size:9px;padding:9px 0;border-bottom:1px solid #ededdf}.mock-row i{font-style:normal;background:#eee8df;padding:5px}.mock-row b{margin-left:auto;color:#96ad71}.visual-number{position:absolute;bottom:12px;right:14px;font-size:10px;color:#6a735a}.chart{height:105px;display:flex;align-items:end;gap:11px;padding:14px 7px 0;border-bottom:1px solid #dde3e2}.chart i{flex:1;height:var(--height);background:#93ae97;border-radius:4px 4px 0 0}.chart i:nth-child(even){background:#bbcda2}.chart-caption{font-size:8px;color:#777d75;margin-top:13px}.project-body{padding-top:20px}.project-body .eyebrow{font-size:9px;color:#727963}h3{font-size:22px;font-weight:500;letter-spacing:-.6px;margin:10px 0}.project-body>p:not(.eyebrow){font-size:13px;line-height:1.8;color:#676d5f}.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:18px}.tags span{font-size:9px;border:1px solid #d5dacb;padding:6px 9px;border-radius:20px}.project-note{font-size:10px;color:#7d8372;margin:30px 0 0}.about{background:#eaece2;padding:80px 0}.about-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:95px}.about h2{font-size:39px}.about-text{font-size:14px;line-height:1.85;color:#646c5b;margin-top:23px}.education{margin-top:30px;padding-top:22px;border-top:1px solid #cdd3c1}.education>span{display:block;font-size:9px;letter-spacing:1.5px;margin-bottom:12px;color:#6f785e}.education strong{font-size:14px}.education p{font-size:12px;line-height:1.8;color:#69735d}.experience{padding-top:5px}.experience article{display:flex;gap:20px;padding:26px 0;border-bottom:1px solid #cdd3c1}.step{font-size:11px;color:#6e7d57;border:1px solid #bac5a7;border-radius:50%;min-width:32px;height:32px;display:grid;place-items:center;margin-top:7px}.experience h3{font-size:20px}.experience p{font-size:13px;line-height:1.8;color:#656e5b}.experience .company{font-size:11px;color:#52683c}.skills-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:26px}.skills-grid article{border-top:1px solid #cdd3c1;padding-top:19px}.skill-number{font-size:10px;color:#7d886b}.skills h3{font-size:18px;margin-top:25px}.skills article p{font-size:12px;line-height:2;color:#68705e}.contact{padding:64px 35px 68px;text-align:center;background:#dcebbd;border-radius:17px;margin-bottom:65px}.contact h2{font-size:clamp(35px,4.4vw,59px)}.contact>p:not(.eyebrow){font-size:14px;line-height:1.8;color:#596648;margin:23px 0}.email{display:block;font-size:12px;margin-top:20px;color:#586545}footer{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #d5dacb;padding:25px 0}footer p,footer>a:last-child{font-size:11px;color:#747d65}.skip{position:absolute;top:-100px;left:16px;padding:12px;background:#25281f;color:white;z-index:10}.skip:focus{top:12px}
  @media(min-width:1500px){.hero{padding-top:110px;padding-bottom:110px}}@media(max-width:1000px){.container{width:calc(100% - 48px)}.hero{gap:25px}.hero-art{height:350px}h1{letter-spacing:-2px}.floating{padding:12px}.note-one{left:8px}.note-two{right:8px}.projects{gap:16px}.project-visual{padding:15px;height:225px}.about-grid{gap:40px}.skills-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.container{width:calc(100% - 36px)}.header{height:84px}nav{gap:15px;font-size:12px}.nav-contact{padding:9px 12px}.nav-contact span{margin-left:4px}.hero{grid-template-columns:1fr;padding:48px 0;gap:40px}h1{font-size:51px}.hero-art{height:330px;max-width:430px;width:100%;margin:auto}.intro{font-size:15px}.location{font-size:8px;margin-top:32px}.ticker .container{flex-wrap:wrap;justify-content:center;font-size:8px;gap:12px}.ticker span{font-size:14px}.section{padding:58px 0}.section-heading{display:block}.section-heading>p{margin-top:20px}.projects{grid-template-columns:1fr;gap:35px}.project-visual{height:270px;padding:35px}.mock-window{max-width:320px}.project-body{padding-top:12px}.project-body>p:not(.eyebrow){font-size:14px}.about{padding:55px 0}.about-grid{grid-template-columns:1fr;gap:28px}.about h2{font-size:34px}.skills-grid{gap:24px 18px}.skills h3{font-size:17px}.contact{padding:46px 18px;margin-bottom:40px}.contact h2{letter-spacing:-1.3px}footer{gap:14px;flex-wrap:wrap}footer p{font-size:10px}.actions{gap:20px}.button{gap:24px;padding:16px 21px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.button{transition:none}}
